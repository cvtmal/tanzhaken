# Every environment variable the app reads, with placeholder values only.
# Copy what you need into .env.local (never committed) and change it there.
# Real environment variables win over .env files.

# Environment: dev, test or prod.
APP_ENV=dev
# Secret for CSRF tokens and signed URLs. Generate one per installation, e.g. `php -r 'echo bin2hex(random_bytes(16));'`.
APP_SECRET=change-me
# Directory for data shared between deployments (relative to the project root).
APP_SHARE_DIR=var/share

# Base URL used when URLs are generated outside an HTTP request (console commands, e-mails).
DEFAULT_URI=http://localhost

# Database. Default: one SQLite file per environment under var/.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# MariaDB/MySQL example (placeholders):
# DATABASE_URL="mysql://user:password@127.0.0.1:3306/tanzhaken?serverVersion=10.11.2-MariaDB&charset=utf8mb4"

# Mail transport. null://null discards every message.
MAILER_DSN=null://null

# Product name shown in titles and the wordmark (gate G3)
APP_BRAND_NAME=TanzHaken
