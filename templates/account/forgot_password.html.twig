{# Forgot password (ACC-3): one email field, then the same answer for every address (R4; PasswordResetController::forgot).
   Variables: form (ForgotPasswordType view); throttled_minutes (int|null: set when the per-IP limiter refused, P2). #}
{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'forgot.title'|trans({}, 'account') }} · {{ brand_name }}{% endblock %}

{% block main %}
    <div class="auth-page">
        {% include 'components/_icon_button.html.twig' with {icon: 'arrow-back', label: 'forgot.back'|trans({}, 'account'), href: path('login'), variant: 'plain', attr: {class: 'auth-page__back'}} only %}
        <h1 class="display-40 auth-page__title">{{ 'forgot.heading'|trans({}, 'account') }}</h1>
        <p class="auth-page__lede">{{ 'forgot.lede'|trans({}, 'account') }}</p>

        {% if throttled_minutes %}
            {% include 'components/_alert.html.twig' with {variant: 'danger', text: 'forgot.throttled'|trans({minutes: throttled_minutes}, 'account')} only %}
        {% endif %}

        {{ form_start(form, {attr: {class: 'auth-form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.email) }}
            {% include 'components/_button.html.twig' with {label: 'forgot.submit'|trans({}, 'account'), type: 'submit', size: 'lg', full_width: true} only %}
        {{ form_end(form) }}

        <p class="auth-page__switch">
            {{ 'forgot.switch.question'|trans({}, 'account') }}
            <a href="{{ path('login') }}">{{ 'forgot.switch.link'|trans({}, 'account') }}</a>
        </p>
    </div>
{% endblock %}
