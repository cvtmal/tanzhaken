{# Reset password: choose a new one (PasswordResetController::reset). Shows nothing about the account beyond
   the form, so a forwarded link reveals no name. The form posts back to the same URL (R7).
   Variables: form (ResetPasswordType view). #}
{% extends 'layout/auth.html.twig' %}

{% set page_scripts = ['password-toggle'] %}

{% block title %}{{ 'reset.title'|trans({}, 'account') }} · {{ brand_name }}{% endblock %}

{% block main %}
    <div class="auth-page">
        <h1 class="display-40 auth-page__title">{{ 'reset.heading'|trans({}, 'account') }}</h1>

        {{ form_start(form, {attr: {class: 'auth-form'}}) }}
            {{ form_errors(form) }}
            {{ form_row(form.password) }}
            {% include 'components/_button.html.twig' with {label: 'reset.submit'|trans({}, 'account'), type: 'submit', size: 'lg', full_width: true} only %}
        {{ form_end(form) }}
    </div>
{% endblock %}
