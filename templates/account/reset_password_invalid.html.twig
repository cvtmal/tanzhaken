{# Reset link malformed, unknown, expired or already used: one page for all, answered with 404 (P3).
   No variables. #}
{% extends 'layout/auth.html.twig' %}

{% block title %}{{ 'reset.invalid.title'|trans({}, 'account') }} · {{ brand_name }}{% endblock %}

{% block main %}
    <div class="auth-page">
        <h1 class="display-40 auth-page__title">{{ 'reset.invalid.heading'|trans({}, 'account') }}</h1>
        <p class="auth-page__lede">{{ 'reset.invalid.text'|trans({}, 'account') }}</p>

        {% include 'components/_link_button.html.twig' with {label: 'reset.invalid.request_new'|trans({}, 'account'), href: path('password_forgot'), size: 'lg', full_width: true} only %}

        <p class="auth-page__switch">
            <a href="{{ path('login') }}">{{ 'reset.invalid.back'|trans({}, 'account') }}</a>
        </p>
    </div>
{% endblock %}
