{# Presentation shell of the teacher's QR page (#16, D8; G1 phone, G2 full screen). A variant of the
   teacher layout kept in the module folder (layouts are #2's hotspot): no navigation, only a close
   icon back to the lesson, the wordmark and the flash region. The page fills the main block.
   Variables: back_href (string, the lesson page). Scripts: toast + alert (the flash region's, as in
   layout/teacher.html.twig) and checkin-live (polling, countdown, copy, full screen; D10).
   The controller sends Cache-Control: no-store and Referrer-Policy: no-referrer; the meta repeats the latter. #}
{% extends 'base.html.twig' %}

{% set layout_scripts = ['toast', 'alert'] %}
{% set page_scripts = ['checkin-live'] %}

{% block meta %}
    <meta name="referrer" content="no-referrer">
{% endblock %}

{% block body_class 'checkin-manage-shell' %}

{% block body %}
    <div class="checkin-manage-shell__frame">
        <header class="checkin-manage-shell__bar">
            {% include 'components/_icon_button.html.twig' with {
                icon: 'close',
                label: 'manage.back'|trans({}, 'checkin'),
                href: back_href,
                variant: 'plain',
            } only %}
            {% include 'components/_wordmark.html.twig' with {size: 'sm'} only %}
        </header>
        <main id="main" class="checkin-manage-shell__main" tabindex="-1">
            {% include 'layout/_flashes.html.twig' %}
            {% block main %}{% endblock %}
        </main>
    </div>
{% endblock %}
