{# Button (<button>), spec §1. Params:
   label (string, translated, required); variant (string 'primary'|'soft'|'secondary'|'text'|'toast-action', default 'primary');
   size (string 'md'|'lg'|'pill'|'pill-sm'|'compact', default 'md'; ignored for 'toast-action', which is always 36 px);
   icon (string|null, sprite id, default null); icon_position (string 'start'|'end', default 'start');
   type (string 'button'|'submit'|'reset', default 'button'); name (string|null, default null); value (string|null, default null);
   disabled (bool, default false); full_width (bool, default false);
   attr (map<string,string>, extra attributes; attr.class is appended to the classes; default {});
   data (map<string,string|true>, printed as data-<key>="<value>", true prints the bare attribute; default {}).
   pill-sm, compact and toast-action are drawn below 44 px and get .hit-target (P8).
   Call: {% include 'components/_button.html.twig' with {label: 'x'|trans, variant: 'soft', size: 'pill-sm', icon: 'add'} only %} #}
{% set variant = variant|default('primary') %}
{% set size = size|default('md') %}
{% set icon = icon|default(null) %}
{% set icon_position = icon_position|default('start') %}
{% set attr = attr|default({}) %}
{% set data = data|default({}) %}
{% set classes = ['btn', 'btn--' ~ variant] %}
{% if variant != 'toast-action' %}{% set classes = classes|merge(['btn--' ~ size]) %}{% endif %}
{% if size in ['pill-sm', 'compact'] or variant == 'toast-action' %}{% set classes = classes|merge(['hit-target']) %}{% endif %}
{% if full_width|default(false) %}{% set classes = classes|merge(['btn--block']) %}{% endif %}
{% if icon %}{% set classes = classes|merge(['btn--icon-' ~ icon_position]) %}{% endif %}
{% if attr.class is defined %}{% set classes = classes|merge([attr.class]) %}{% endif %}
<button type="{{ type|default('button') }}" class="{{ classes|join(' ') }}"
    {%- if name|default(null) is not null %} name="{{ name }}"{% endif %}
    {%- if value|default(null) is not null %} value="{{ value }}"{% endif %}
    {%- if disabled|default(false) %} disabled{% endif %}
    {%- for key, val in attr|filter((v, k) => k != 'class') %} {{ key }}="{{ val }}"{% endfor %}
    {%- for key, val in data %}{% if val is same as(true) %} data-{{ key }}{% else %} data-{{ key }}="{{ val }}"{% endif %}{% endfor %}>
    {%- if icon and icon_position == 'start' %}{{ icon(icon, null, 'btn__icon') }}{% endif -%}
    <span class="btn__label">{{ label }}</span>
    {%- if icon and icon_position == 'end' %}{{ icon(icon, null, 'btn__icon') }}{% endif -%}
</button>
