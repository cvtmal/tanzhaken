{# Page header (spec §5), embed with an action slot. Params:
   title (string, required); subtitle (string|null, default null);
   back_href (string|null, default null) + back_label (string, translated, required with back_href): arrow-back icon link above the title;
   breadcrumbs (list of {label: string, href: string|null}, default []: the last one is the current page);
   level (int 1-3, heading level of the title, default 1).
   Block: page_actions (buttons or link buttons next to the title).
   Call: {% embed 'components/_page_header.html.twig' with {title: 'courses.title'|trans({}, 'courses')} only %}{% block page_actions %}…{% endblock %}{% endembed %} #}
{% set subtitle = subtitle|default(null) %}
{% set back_href = back_href|default(null) %}
{% set breadcrumbs = breadcrumbs|default([]) %}
{% set level = level|default(1) %}
<header class="page-header">
    {%- if back_href %}
        <div class="page-header__back">
            {% include 'components/_icon_button.html.twig' with {icon: 'arrow-back', label: back_label, href: back_href, variant: 'plain'} only %}
        </div>
    {%- endif %}
    {%- if breadcrumbs is not empty %}
        <nav class="page-header__crumbs" aria-label="{{ 'component.page_header.breadcrumbs'|trans }}">
            <ol class="crumbs">
                {%- for crumb in breadcrumbs %}
                    <li class="crumbs__item">
                        {%- if not loop.last and crumb.href|default(null) %}<a class="crumbs__link" href="{{ crumb.href }}">{{ crumb.label }}</a>{{ icon('chevron-right', null, 'crumbs__sep') }}{% else %}<span{% if loop.last %} aria-current="page"{% endif %}>{{ crumb.label }}</span>{% endif -%}
                    </li>
                {%- endfor %}
            </ol>
        </nav>
    {%- endif %}
    <div class="page-header__row">
        <div class="page-header__text">
            <h{{ level }} class="page-header__title">{{ title }}</h{{ level }}>
            {%- if subtitle %}<p class="page-header__subtitle">{{ subtitle }}</p>{% endif %}
        </div>
        <div class="page-header__actions">{% block page_actions %}{% endblock %}</div>
    </div>
</header>
