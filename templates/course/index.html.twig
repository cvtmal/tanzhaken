{# Courses (C1 mobile, C3 desktop list; C2 empty state). Active courses only, ordered by weekday and time
   (CourseOverview). Variables: cards (list<App\Courses\ReadModel\CourseCard>). #}
{% extends 'layout/teacher.html.twig' %}
{% trans_default_domain 'courses' %}

{% block title %}{{ 'course.index.title'|trans }} · {{ brand_name }}{% endblock %}

{% block main %}
    <div class="course-list">
        {% embed 'components/_page_header.html.twig' with {title: 'course.index.title'|trans, has_courses: cards is not empty} only %}
            {% trans_default_domain 'courses' %}
            {% block page_actions %}
                {%- if has_courses %}
                    {% include 'components/_link_button.html.twig' with {label: 'course.index.new'|trans, href: path('course_new'), variant: 'soft', size: 'pill', icon: 'add'} only %}
                {%- endif %}
            {% endblock %}
        {% endembed %}

        {% if cards is empty %}
            {% include 'components/_empty_state.html.twig' with {
                title: 'course.empty.title'|trans,
                text: 'course.empty.text'|trans,
                action: {label: 'course.empty.action'|trans, href: path('course_new'), icon: 'add'},
            } only %}
        {% else %}
            {% embed 'components/_list.html.twig' with {label: 'course.index.list_label'|trans, cards: cards} only %}
                {% block list_items %}
                    {%- for card in cards %}
                        {% include 'course/_card.html.twig' with {card: card} only %}
                    {%- endfor %}
                {% endblock %}
            {% endembed %}
        {% endif %}
    </div>
{% endblock %}
