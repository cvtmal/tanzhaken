{# Correct a credit entry (credit_correct, CRD-5, S9 "void plus a new grant", PD2). Header "Correct this
   entry" with the back arrow, the entry (credit/_grant_summary), the explanation that saving voids it
   and adds the corrected one, the amount block (credit/_amount_fields: Now → After counts the corrected
   amount instead of this entry's), date, note, optional reason, "Save correction" + Cancel.
   Variables: see the class docblock of App\Credits\Controller\CreditController. #}
{% extends 'layout/teacher.html.twig' %}
{% trans_default_domain 'credits' %}
{% set page_scripts = ['credit-amount'] %}
{% set name = student.firstName ~ ' ' ~ student.lastName %}

{% block title %}{{ 'credits.correct.title'|trans }} · {{ brand_name }}{% endblock %}

{% block main %}
    {% if from == 'student' %}
        {% set back_label = 'credits.back.student'|trans({name: name}) %}
    {% elseif from == 'dashboard' %}
        {% set back_label = 'credits.back.dashboard'|trans %}
    {% else %}
        {% set back_label = 'credits.back.course'|trans %}
    {% endif %}
    {% set base = balance.balance - grant.quantity %}
    {% set quantity = form.vars.value.quantity() %}
    {% set after = base + (quantity > 0 ? quantity : grant.quantity) %}

    <div class="credit-page">
        {% include 'components/_page_header.html.twig' with {title: 'credits.correct.title'|trans, subtitle: name, back_href: back_url, back_label: back_label} only %}

        {% include 'credit/_grant_summary.html.twig' with {grant: grant, course_name: course.name, timezone: app.user.timezone} only %}

        <p class="credit-page__explain">{{ 'credits.correct.explain'|trans }}</p>

        {{ form_start(form, {attr: {class: 'credit-form'}}) }}
            {{ form_errors(form) }}
            {% include 'credit/_amount_fields.html.twig' with {form: form, before: balance.balance, base: base, after: after} only %}
            {{ form_row(form.date) }}
            {{ form_row(form.note) }}
            {{ form_row(form.reason) }}
            <div class="credit-form__footer credit-form__footer--pair">
                {% include 'components/_link_button.html.twig' with {label: 'credits.correct.cancel'|trans, href: back_url, variant: 'secondary', size: 'lg'} only %}
                {% include 'components/_button.html.twig' with {label: 'credits.correct.submit'|trans, type: 'submit', size: 'lg'} only %}
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
